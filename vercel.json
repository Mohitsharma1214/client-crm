{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["static/**", "data/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/demo-site/(.*)",
      "dest": "/demo-site/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}

